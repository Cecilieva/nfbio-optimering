# Kopiér denne fil til .env og udfyld. .env må ALDRIG på GitHub.

# TMDB → themoviedb.org → Settings → API → "API Read Access Token" (den lange)
TMDB_READ_ACCESS_TOKEN=

# Supabase → Project Settings → API
SUPABASE_URL=https://DIT-PROJEKT.supabase.co
# "service_role"-nøglen (hemmelig – kun til dette script, aldrig i React-appen)
SUPABASE_SERVICE_ROLE_KEY=

# Valgfrit
MAX_MOVIES=20
CREATE_SHOWTIMES=true
